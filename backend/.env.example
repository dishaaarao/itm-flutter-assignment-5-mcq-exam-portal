# ============================================================
# Server
# ============================================================
PORT=5050
NODE_ENV=development

# ============================================================
# Backend selection
#
# DATA_BACKEND=memory     -> in-process store, no accounts needed (default)
# DATA_BACKEND=firestore  -> real Firebase Cloud Firestore
#
# STORAGE_BACKEND=local      -> files saved to ./uploads (default)
# STORAGE_BACKEND=cloudinary -> real Cloudinary storage
#
# The defaults let the whole app run and be demoed with zero credentials.
# ============================================================
DATA_BACKEND=memory
STORAGE_BACKEND=local

# ============================================================
# Auth
#
# JWT_SECRET must be set to a long random value in production.
# The server refuses to boot with the fallback secret when NODE_ENV=production.
# ============================================================
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seconds of network grace allowed past the exam deadline before a
# submission is flagged as late. The answer is still graded either way.
SUBMIT_GRACE_SECONDS=30

# Allow a student to retake an exam they already submitted
ALLOW_REATTEMPT=false

# Seeded admin account (admins cannot self-register)
SEED_ADMIN_EMAIL=admin@mcq.local
SEED_ADMIN_PASSWORD=Admin@123

# ============================================================
# Firebase  (required only when DATA_BACKEND=firestore)
#
# Option 1: path to a service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option 2: individual credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ============================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ============================================================
# Cloudinary  (required only when STORAGE_BACKEND=cloudinary)
# Dashboard -> Account Details
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
